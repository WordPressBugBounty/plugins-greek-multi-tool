#: includes/text-analysis.php:19
msgid "Words with two or more syllables must carry an accent."
msgstr "Οι λέξεις με δύο ή περισσότερες συλλαβές παίρνουν τόνο."

#: includes/text-analysis.php:20
msgid "Words that become monosyllabic after elision or apocope keep their accent."
msgstr "Λέξεις που γίνονται μονοσύλλαβες μετά από έκθλιψη ή αποκοπή κρατούν τον τόνο τους."

#: includes/text-analysis.php:21
msgid "Words that lost their accent through aphaeresis are exceptions."
msgstr "Λέξεις που έχασαν τον τόνο τους με αφαίρεση αποτελούν εξαίρεση."

#: includes/text-analysis.php:22
msgid "Monosyllabic words do not take an accent, with specific exceptions."
msgstr "Οι μονοσύλλαβες λέξεις δεν παίρνουν τόνο, με συγκεκριμένες εξαιρέσεις."

#: includes/text-analysis.php:23
msgid "Common words such as “όλα”, “ένα”, “όταν” are recognized as correctly accented."
msgstr "Συνηθισμένες λέξεις όπως «όλα», «ένα», «όταν» αναγνωρίζονται ως σωστά τονισμένες."

#: includes/text-analysis.php:24
msgid "Words such as “μου”, “σου”, “του”, “το”, “τα”, “για”, “πιο”, “ναι”, “και”, “οι” never take an accent."
msgstr "Λέξεις όπως «μου», «σου», «του», «το», «τα», «για», «πιο», «ναι», «και», «οι» δεν παίρνουν ποτέ τόνο."

#: includes/text-analysis.php:25
msgid "The disjunctive conjunction “ή” always takes an accent."
msgstr "Ο διαζευκτικός σύνδεσμος «ή» παίρνει πάντα τόνο."

#: includes/text-analysis.php:26
msgid "Interrogative “πού” and “πώς” take an accent in questions."
msgstr "Τα ερωτηματικά «πού» και «πώς» παίρνουν τόνο στις ερωτήσεις."

#: includes/text-analysis.php:27
msgid "“πού” and “πώς” keep their accent in set phrases such as “πού και πού”."
msgstr "Τα «πού» και «πώς» κρατούν τον τόνο σε στερεότυπες φράσεις όπως «πού και πού»."

#: includes/text-analysis.php:28
msgid "Words written in capitals do not carry accents, except “Ή”."
msgstr "Οι λέξεις με κεφαλαία δεν παίρνουν τόνο, εκτός από το «Ή»."

#. translators: %s: word
#: includes/text-analysis.php:131
#, php-format
msgid "“%s” is written in capitals and should not carry an accent."
msgstr "Το «%s» είναι με κεφαλαία και δεν πρέπει να έχει τόνο."

#. translators: %s: word
#: includes/text-analysis.php:137
#, php-format
msgid "“%s” never takes an accent."
msgstr "Το «%s» δεν παίρνει ποτέ τόνο."

#. translators: %s: word
#: includes/text-analysis.php:152
#, php-format
msgid "“%s” has more than one syllable and should carry an accent."
msgstr "Το «%s» έχει περισσότερες από μία συλλαβές και πρέπει να έχει τόνο."

#. translators: %s: word
#: includes/text-analysis.php:202
#, php-format
msgid "“%s” should carry an accent in this context."
msgstr "Το «%s» πρέπει να έχει τόνο σε αυτό το σημείο."

#. translators: %s: word
#: includes/text-analysis.php:204
#, php-format
msgid "“%s” is monosyllabic and should not carry an accent."
msgstr "Το «%s» είναι μονοσύλλαβο και δεν πρέπει να έχει τόνο."

