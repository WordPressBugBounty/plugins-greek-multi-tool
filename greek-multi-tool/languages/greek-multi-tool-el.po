#. Plugin Name of the plugin
#: grmlt-plugin.php
msgid "Greek Multi Tool"
msgstr "Greek Multi Tool"

#. Plugin URI of the plugin
#: grmlt-plugin.php
msgid "https://bigdrop.gr/greek-multi-tool"
msgstr "https://bigdrop.gr/greek-multi-tool"

#. Description of the plugin
#: grmlt-plugin.php
msgid "Greek-to-Latin permalinks and media file names (ELOT 743), one-click conversion of old Greek permalinks with 301 redirects, a Greek accent checker for the editor, and Greek readiness checks in Site Health."
msgstr "Λατινικοί μόνιμοι σύνδεσμοι και ονόματα αρχείων πολυμέσων (ΕΛΟΤ 743), μετατροπή παλιών ελληνικών συνδέσμων με ένα κλικ και ανακατευθύνσεις 301, έλεγχος τονισμού στον επεξεργαστή, και έλεγχοι ελληνικής ετοιμότητας στην Υγεία ιστοτόπου."

#. Author of the plugin
#: grmlt-plugin.php
msgid "BigDrop.gr"
msgstr "BigDrop.gr"

#. Author URI of the plugin
#: grmlt-plugin.php
msgid "https://bigdrop.gr"
msgstr "https://bigdrop.gr"

